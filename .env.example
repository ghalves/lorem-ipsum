# URL pública do app (HTTPS em produção). Usada no OAuth, webhooks e no script da vitrine.
APP_URL=https://app.miaou.com.br
PORT=3000
APP_NAME=Miaou
# Site da Miaou (link da marca no provador) e e-mail de suporte mostrado no painel
MIAOU_SITE_URL=https://miaou.com.br
MIAOU_SUPPORT_EMAIL=suporte@miaou.com.br

# Portal de Parceiros Nuvemshop > seu app > Dados básicos
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_CONTACT_EMAIL=voce@suaempresa.com.br
# id do script da vitrine cadastrado no portal (não auto-instalável)
NUVEMSHOP_SCRIPT_ID=
# versão da API REST
NUVEMSHOP_API_VERSION=2025-03

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

DATABASE_PATH=./data/provador.db

# true = habilita /dev (loja de demonstração). Nunca em produção.
DEV_MODE=false
# Script do checkout (mesmo miaou-nube.js, local de ativação Checkout): liga o pedido ao provador
NUVEMSHOP_SCRIPT_ID_CHECKOUT=

# ===== Provador virtual =====
# Chave do OpenRouter. Sem ela o gerador fica em modo simulado (devolve a própria foto).
OPENROUTER_API_KEY=
# Modelos (ids do OpenRouter)
TRYON_PRIMARY_MODEL=meta/muse-image
TRYON_FALLBACK_MODEL=google/gemini-3.1-flash-image
TRYON_DESCRIBE_MODEL=google/gemini-3.1-flash-lite
# Óculos: modelo principal e reserva (mesma ordem das roupas)
TRYON_GLASSES_PRIMARY_MODEL=meta/muse-image
TRYON_GLASSES_FALLBACK_MODEL=google/gemini-3.1-flash-image
# Passou deste tempo sem resposta do principal, a reserva começa em paralelo (ms)
TRYON_HEDGE_AFTER_MS=30000
# Cola a prova de volta na foto original (rosto e fundo originais). false = entrega a imagem da IA como veio
TRYON_COMPOSITE=true
# Óculos: a IA recebe só a cabeça; espera a análise da foto no máximo isso (ms), depois segue com a foto inteira
TRYON_GLASSES_CROP=true
TRYON_ANALYSIS_WAIT_MS=5000
# Plano das lojas novas até a cobrança da Nuvemshop estar ligada: none | essencial | crescer | escalar | pro
TRYON_DEFAULT_PLAN=none
# Proteção da cota: provas por IP por dia em cada loja (o limite por comprador fica em Preferências, padrão 10)
TRYON_IP_DAILY_LIMIT=20
# Pasta das fotos e provas (apagadas em 24 h / 7 dias)
TRYON_STORAGE_DIR=./data/tryon

